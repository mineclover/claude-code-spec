{
  "name": "@context-action/session-core",
  "version": "0.1.0",
  "description": "Cache-preserving session analytics and prefix-hash domain logic, transport-agnostic and Electron-free.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./hash": {
      "types": "./dist/prefixHashing.d.ts",
      "import": "./dist/prefixHashing.mjs",
      "require": "./dist/prefixHashing.js"
    },
    "./fingerprint": {
      "types": "./dist/observedFingerprint.d.ts",
      "import": "./dist/observedFingerprint.mjs",
      "require": "./dist/observedFingerprint.js"
    },
    "./summary": {
      "types": "./dist/summary.d.ts",
      "import": "./dist/summary.mjs",
      "require": "./dist/summary.js"
    },
    "./server/readers": {
      "types": "./dist/server-readers.d.ts",
      "import": "./dist/server-readers.mjs",
      "require": "./dist/server-readers.js"
    },
    "./server/summary-store": {
      "types": "./dist/server-summary-store.d.ts",
      "import": "./dist/server-summary-store.mjs",
      "require": "./dist/server-summary-store.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts src/prefixHashing.ts src/observedFingerprint.ts src/summary.ts src/server-readers.ts src/server-summary-store.ts --format cjs,esm --dts --splitting",
    "dev": "tsup src/index.ts src/prefixHashing.ts src/observedFingerprint.ts src/summary.ts src/server-readers.ts src/server-summary-store.ts --format cjs,esm --dts --splitting --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "session",
    "cache",
    "prefix-hash",
    "claude",
    "codex",
    "gemini"
  ],
  "author": {
    "name": "mineclover",
    "email": "mineclover@naver.com"
  },
  "license": "MIT",
  "peerDependencies": {
    "@context-action/code-api": "*"
  },
  "devDependencies": {
    "@context-action/code-api": "*",
    "@types/node": "^25.6.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
