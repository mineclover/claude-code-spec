{
  "name": "@apps/session-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Cache-preserving session viewer (PoC). Vite + React 19 today; Electrobun-ready transport-agnostic data source.",
  "scripts": {
    "dev": "vite",
    "dev:vite": "vite",
    "dev:bun": "electrobun dev",
    "dev:hmr": "concurrently -k -n vite,bun -c green,blue \"npm:dev:vite\" \"vite build && electrobun dev\"",
    "build": "tsc --noEmit && vite build",
    "build:electrobun": "vite build && electrobun build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@context-action/cli-runner": "*",
    "@context-action/code-api": "*",
    "@context-action/session-core": "*",
    "i18next": "^26.0.9",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electrobun": "^1.18.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
