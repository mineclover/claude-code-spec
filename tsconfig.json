{
  "compilerOptions": {
    "target": "ESNext",
    "module": "commonjs",
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "outDir": "dist",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "resolveJsonModule": true,
    "strict": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@context-action/session-core/hash": [
        "node_modules/@context-action/session-core/dist/prefixHashing.d.ts"
      ],
      "@context-action/session-core/fingerprint": [
        "node_modules/@context-action/session-core/dist/observedFingerprint.d.ts"
      ]
    }
  },
  "include": ["src/**/*"]
}
